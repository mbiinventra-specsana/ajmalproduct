# MbiInventra RCM Academy — environment variables
# Copy to .env on your server and fill in real values. NEVER commit .env to git.

# ---- server ----
PORT=3000

# ---- database: SQLite (default) ----
# IMPORTANT: point DATA_DIR OUTSIDE the deployed project folder,
# otherwise a GitHub redeploy can wipe bill.db. Example:
# DATA_DIR=/home/youruser/rcm-data
DATA_DIR=./data

# ---- database: MariaDB/MySQL (optional) ----
# To use MariaDB instead of SQLite, set:
# DB_ENGINE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=your_db_user
# DB_PASS=your_db_password
# DB_NAME=rcm_academy
# Tables auto-create on first boot.

# ---- owner login ----
# Login email becomes ADMIN_USER@local (default: admin@local)
ADMIN_USER=admin
# CHANGE THIS on deploy:
ADMIN_PASS=vip123

# ---- security ----
# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set to 1 once SSL/HTTPS is enabled on the domain:
COOKIE_SECURE=0

# ---- hidden legacy admin path (owner panel is at /owner) ----
ADMIN_PATH=/admin
